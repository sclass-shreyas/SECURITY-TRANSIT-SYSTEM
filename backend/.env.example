APP_NAME=Smart Transit Security Backend
APP_ENV=development
API_V1_PREFIX=
SECRET_KEY=change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smart_transit
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smart_transit_test
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=false
CLIPS_BASE_DIR=../analytics/clips
CORS_ORIGINS=http://localhost:3000
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_CAMERA_ID=00000000-0000-0000-0000-000000000001
